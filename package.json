{
  "name": "all-about-cards-fl",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.20.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit tests/integration tests/component",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "prisma:format": "prisma format",
    "prisma:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://aacfl:aacfl@localhost:5432/aacfl_test?schema=public} prisma validate",
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://aacfl:aacfl@localhost:5432/aacfl_test?schema=public} prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "owner:bootstrap": "tsx scripts/bootstrap-owner.ts",
    "security:audit": "npm audit --audit-level=moderate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:reset:test": "tsx scripts/reset-test-db.ts",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.10.0",
    "@prisma/client": "6.12.0",
    "next": "15.5.20",
    "next-auth": "5.0.0-beta.31",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.61.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.13.14",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.21",
    "eslint": "9.31.0",
    "eslint-config-next": "15.4.1",
    "jsdom": "26.1.0",
    "postcss": "8.5.10",
    "prettier": "3.6.2",
    "prisma": "6.12.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
